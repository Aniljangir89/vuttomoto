datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  role         String     @default("BUYER") // BUYER, SELLER, ADMIN
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  motorcycles  Motorcycle[]
  bids         Bid[]
  auditLogs    AuditLog[]
  wonAuctions  Auction[]  @relation("AuctionWinner")
}

model Motorcycle {
  id          String   @id @default(uuid())
  make        String
  model       String
  year        Int
  mileage     Int
  engineCc    Int
  condition   String   // Mint, Excellent, Good, Fair, Custom
  titleStatus String   // Clean, Rebuilt, Salvage
  imagesJson  String   // JSON string array of image URLs
  specsJson   String   // JSON object string for technical specs (HP, Torque, Weight, etc.)
  sellerId    String
  seller      User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  auctions    Auction[]
}

model Auction {
  id               String   @id @default(uuid())
  motorcycleId     String
  motorcycle       Motorcycle @relation(fields: [motorcycleId], references: [id], onDelete: Cascade)
  title            String
  description      String
  startingBid      Float
  reservePrice     Float
  minBidIncrement  Float    @default(100.0)
  currentBid       Float    @default(0.0)
  winningUserId    String?
  winningUser      User?    @relation("AuctionWinner", fields: [winningUserId], references: [id])
  status           String   @default("DRAFT") // DRAFT, SCHEDULED, LIVE, ENDED, SOLD, UNSOLD, CANCELLED
  startTime        DateTime
  endTime          DateTime
  antiSnipeSeconds Int      @default(120) // Extend by N seconds if bid placed in last N seconds
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bids             Bid[]
}

model Bid {
  id            String   @id @default(uuid())
  auctionId     String
  auction       Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Float
  maxProxyAmount Float?
  isAutoBid     Boolean  @default(false)
  timestamp     DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  detailsJson String?
  ipAddress   String?
  timestamp   DateTime @default(now())
}
